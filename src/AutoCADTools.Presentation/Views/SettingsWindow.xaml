<Window x:Class="AutoCADTools.Presentation.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:vm="clr-namespace:AutoCADTools.Presentation.ViewModels"
        xmlns:utils="clr-namespace:AutoCADTools.Presentation.Utils"
        Title="{utils:Loc View.Settings.Title}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        d:DataContext="{d:DesignInstance vm:SettingViewModel, IsDesignTimeCreatable=True}"
        Width="350"
        Height="150"
        ShowInTaskbar="False">
  <Grid Margin="15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
      <Label Content="{utils:Loc View.Settings.Language}" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <ComboBox
        ItemsSource="{Binding AvailableLanguages}"
        SelectedItem="{Binding SelectedLanguageItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
        DisplayMemberPath="DisplayName"
        MinWidth="180"
        VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{utils:Loc View.Settings.Button.Save}" Command="{Binding SaveCommand}" MinWidth="80" Margin="5,0,0,0"/>
      <Button Content="{utils:Loc View.Settings.Button.Cancel}" Command="{Binding CancelCommand}" MinWidth="80" Margin="5,0,0,0"/>
    </StackPanel>
  </Grid>
</Window>
