<Window x:Class="AutoCADTools.Presentation.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="350"
        Height="150"
        ShowInTaskbar="False">
  <Grid Margin="15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
      <Label Content="{Binding LanguageLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <ComboBox
        x:Name="LanguageComboBox"
        ItemsSource="{Binding AvailableLanguages}"
        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
        DisplayMemberPath="DisplayName"
        MinWidth="180"
        VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" MinWidth="80" Margin="5,0,0,0"/>
      <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" MinWidth="80" Margin="5,0,0,0"/>
    </StackPanel>
  </Grid>
</Window>
