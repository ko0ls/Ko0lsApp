<Window x:Class="AutoCADTools.Presentation.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:AutoCADTools.Presentation.Utils"
        Title="{utils:Loc Settings.Title}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="350"
        Height="150"
        ShowInTaskbar="False">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="80"/>
      <Setter Property="Margin" Value="5,0,0,0"/>
    </Style>
  </Window.Resources>

  <Grid Margin="15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Language row -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
      <Label Content="Language:" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <ComboBox
        x:Name="LanguageComboBox"
        MinWidth="180"
        VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Buttons row -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="SaveButton" MinWidth="80" Margin="5,0,0,0" Click="SaveButton_Click"/>
      <Button x:Name="CancelButton" MinWidth="80" Margin="5,0,0,0" Click="CancelButton_Click"/>
    </StackPanel>
  </Grid>
</Window>
