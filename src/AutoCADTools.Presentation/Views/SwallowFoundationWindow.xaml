<Window x:Class="AutoCADTools.Presentation.Views.SwallowFoundationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AutoCADTools.Presentation.ViewModels"
        xmlns:utils="clr-namespace:AutoCADTools.Presentation.Utils"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="{utils:Loc SwallowFoundation.Window.Title}"
        WindowStartupLocation="CenterOwner"
        Width="900"
        Height="650"
        MinWidth="700"
        MinHeight="500"
        ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance vm:SwallowFoundationViewModel, IsDesignTimeCreatable=True}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Common.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <!--
    Layout: DockPanel
    - Canvas fills all available space on the left (DockPanel.Dock=Left)
      → grows when window is maximized
    - Form scrolls on the right (remaining space)
    - Buttons dock at bottom (DockPanel.Dock=Bottom)
  -->
  <DockPanel Margin="9">
    <!-- ── Bottom: OK / Cancel buttons ── -->
    <Border DockPanel.Dock="Bottom"
            BorderBrush="{StaticResource Container.Static.Border.Default}"
            BorderThickness="0 1 0 0">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0 9 0 0">
        <Button Content="{utils:Loc SwallowFoundation.Button.OK}"
                Command="{Binding OKCommand}"
                Margin="0 0 9 0"/>
        <Button Content="{utils:Loc SwallowFoundation.Button.Cancel}"
                Command="{Binding CancelCommand}"/>
      </StackPanel>
    </Border>

    <!-- ── Content: Form (left, scrollable) | Canvas (right, fills available space) ── -->
    <Grid>
      <Grid.ColumnDefinitions>
        <!-- Form: minimum fixed width -->
        <ColumnDefinition Width="400" MinWidth="00"/>
        <!-- Vertical separator -->
        <ColumnDefinition Width="Auto"/>
        <!-- Canvas: fills all available horizontal space -->
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ── Left: Input Form Panel ── -->
      <ScrollViewer Grid.Column="0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Margin="9">
        <StackPanel>

          <!-- Foundation Identification -->
          <TextBlock Text="{utils:Loc SwallowFoundation.Group.Foundation}"
                     FontWeight="Bold"
                     Margin="0 0 0 4"/>
          <Grid Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Foundation Name -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.FoundationName}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 4"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding FoundationName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource InputTextBox}"
                     HorizontalAlignment="Left"
                     Margin="0 0 0 4"/>

            <!-- Quantity -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.Quantity}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 4"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource NumericInputTextBox}"
                     HorizontalAlignment="Left"
                     Margin="0 0 0 4"/>

            <!-- Scale -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.Scale}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 0"/>
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource NumericInputTextBox}"
                     HorizontalAlignment="Left"/>
          </Grid>

          <!-- Separator -->
          <Separator Margin="0 0 0 8"/>

          <!-- Footing Dimensions -->
          <TextBlock Text="{utils:Loc SwallowFoundation.Group.FootingDimensions}"
                     FontWeight="Bold"
                     Margin="0 0 0 4"/>
          <Grid Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- LengthX -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.LengthX}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 4"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding LengthX, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource NumericInputTextBox}"
                     HorizontalAlignment="Left"
                     Margin="0 0 0 4"/>

            <!-- LengthY -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.LengthY}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 4"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding LengthY, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource NumericInputTextBox}"
                     HorizontalAlignment="Left"
                     Margin="0 0 0 4"/>

            <!-- AxisPositionX -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.AxisPositionX}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 4"/>
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding AxisPositionX, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource NumericInputTextBox}"
                     HorizontalAlignment="Left"
                     Margin="0 0 0 4"/>

            <!-- AxisPositionY -->
            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.AxisPositionY}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 0"/>
            <TextBox Grid.Row="3" Grid.Column="1"
                     Text="{Binding AxisPositionY, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource NumericInputTextBox}"
                     HorizontalAlignment="Left"/>
          </Grid>

          <!-- Separator -->
          <Separator Margin="0 0 0 8"/>

          <!-- Step Heights -->
          <TextBlock Text="{utils:Loc SwallowFoundation.Group.StepHeights}"
                     FontWeight="Bold"
                     Margin="0 0 0 4"/>
          <Grid Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- StepHeightH1 -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.StepH1}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 4"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding StepHeightH1, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource NumericInputTextBox}"
                     HorizontalAlignment="Left"
                     Margin="0 0 0 4"/>

            <!-- StepHeightH2 -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.StepH2}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 0"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding StepHeightH2, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource NumericInputTextBox}"
                     HorizontalAlignment="Left"/>
          </Grid>

          <!-- Separator -->
          <Separator Margin="0 0 0 8"/>

          <!-- Foundation Levels -->
          <TextBlock Text="{utils:Loc SwallowFoundation.Group.FoundationLevels}"
                     FontWeight="Bold"
                     Margin="0 0 0 4"/>
          <Grid Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- FoundationBottomLevel -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.FoundationBottomLevel}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 4"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding FoundationBottomLevel, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource NumericInputTextBox}"
                     HorizontalAlignment="Left"
                     Margin="0 0 0 4"/>

            <!-- FloorLevel -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.FloorLevel}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 4"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding GroundLevel, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource NumericInputTextBox}"
                     HorizontalAlignment="Left"
                     Margin="0 0 0 4"/>

            <!-- FloorLevelT1 -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.FloorLevel1}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 0"/>
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding FloorLevel1, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource NumericInputTextBox}"
                     HorizontalAlignment="Left"/>
          </Grid>

          <!-- Separator -->
          <Separator Margin="0 0 0 8"/>

          <!-- Concrete Pad -->
          <TextBlock Text="{utils:Loc SwallowFoundation.Group.ConcretePad}"
                     FontWeight="Bold"
                     Margin="0 0 0 4"/>
          <Grid Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ConcretePadExtension -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.ConcretePadExtension}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 4"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding ConcretePadExtension, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource NumericInputTextBox}"
                     HorizontalAlignment="Left"
                     Margin="0 0 0 4"/>

            <!-- ConcretePadThickness -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.ConcretePadThickness}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 0"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding ConcretePadThickness, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource NumericInputTextBox}"
                     HorizontalAlignment="Left"/>
          </Grid>

          <!-- Separator -->
          <Separator Margin="0 0 0 8"/>

          <!-- Column Properties -->
          <TextBlock Text="{utils:Loc SwallowFoundation.Group.Column}"
                     FontWeight="Bold"
                     Margin="0 0 0 4"/>
          <Grid Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column shape -->
            <TextBlock Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.ColumnShape}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 4"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0 0 0 4">
              <RadioButton Content="{utils:Loc SwallowFoundation.Label.ColumnShape.Rectangular}"
                           IsChecked="{Binding IsRectangularColumn}"
                           Margin="0 0 12 0"/>
              <RadioButton Content="{utils:Loc SwallowFoundation.Label.ColumnShape.Circular}"
                           IsChecked="{Binding IsRectangularColumn, Converter={StaticResource InverseBooleanConverter}}"/>
            </StackPanel>
          </Grid>
          <Grid Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ColumnWidthX -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.ColumnWidthX}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 4"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding ColumnWidthX, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource NumericInputTextBox}"
                     HorizontalAlignment="Left"
                     Margin="0 0 0 4"/>

            <!-- ColumnWidthY -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.ColumnWidthY}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 4"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding ColumnWidthY, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource NumericInputTextBox}"
                     HorizontalAlignment="Left"
                     Margin="0 0 0 4"/>

            <!-- ColumnPositionX -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.ColumnPositionX}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 4"/>
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding ColumnPositionX, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource NumericInputTextBox}"
                     HorizontalAlignment="Left"
                     Margin="0 0 0 4"/>

            <!-- ColumnPositionY -->
            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.ColumnPositionY}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 0"/>
            <TextBox Grid.Row="3" Grid.Column="1"
                     Text="{Binding ColumnPositionY, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource NumericInputTextBox}"
                     HorizontalAlignment="Left"/>
          </Grid>

          <!-- Separator -->
          <Separator Margin="0 0 0 8"/>

          <!-- Rebar -->
          <TextBlock Text="{utils:Loc SwallowFoundation.Group.Rebar}"
                     FontWeight="Bold"
                     Margin="0 0 0 4"/>
          <Grid Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- RebarX -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.RebarX}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 4"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding RebarX, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource InputTextBox}"
                     HorizontalAlignment="Left"
                     Margin="0 0 0 4"/>

            <!-- RebarY -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.RebarY}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 4"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding RebarY, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     Style="{StaticResource InputTextBox}"
                     HorizontalAlignment="Left"
                     Margin="0 0 0 4"/>

            <!-- PrimaryDirection -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{utils:Loc SwallowFoundation.Label.PrimaryDirection}"
                       VerticalAlignment="Center"
                       Margin="0 0 8 0"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
              <RadioButton Content="X"
                           IsChecked="{Binding PrimaryDirection, Converter={StaticResource StringMatchConverter}, ConverterParameter=X}"
                           GroupName="PrimaryDirection"
                           Margin="0 0 12 0" VerticalAlignment="Center"/>
              <RadioButton Content="Y"
                           IsChecked="{Binding PrimaryDirection, Converter={StaticResource StringMatchConverter}, ConverterParameter=Y}"
                           GroupName="PrimaryDirection"
                           VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>

          <!-- Separator -->
          <Separator Margin="0 0 0 8"/>

          <!-- Column Rebar Details -->
          <TextBlock Text="{utils:Loc SwallowFoundation.Group.ColumnRebarDetails}"
                     FontWeight="Bold"
                     Margin="0 0 0 4"/>

          <CheckBox Content="{utils:Loc SwallowFoundation.Label.DrawColumnRebar}"
                    IsChecked="{Binding DrawColumnRebar}"
                    Margin="0 0 0 4"/>
          <StackPanel IsEnabled="{Binding DrawColumnRebar}">
            <CheckBox Content="{utils:Loc SwallowFoundation.Label.AlternateRebarSpacing}"
                      IsChecked="{Binding IsStaggeredLayout}"
                      Margin="0 0 0 8"/>
            <Grid Margin="0 0 0 8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- ColumnRebar -->
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="{utils:Loc SwallowFoundation.Label.ColumnRebar}"
                         VerticalAlignment="Center"
                         Margin="0 0 8 4"/>
              <ComboBox Grid.Row="0" Grid.Column="1"
                        ItemsSource="{Binding ColumnRebarOptions}"
                        SelectedItem="{Binding ColumnRebar}"
                        IsEditable="True"
                        Width="60"
                        HorizontalAlignment="Left"
                        Margin="0 0 0 4"/>

              <!-- StirrupRebar -->
              <TextBlock Grid.Row="1" Grid.Column="0"
                         Text="{utils:Loc SwallowFoundation.Label.StirrupRebar}"
                         VerticalAlignment="Center"
                         Margin="0 0 8 4"/>
              <TextBox Grid.Row="1" Grid.Column="1"
                       Text="{Binding StirrupRebar, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                       Style="{StaticResource InputTextBox}"
                       HorizontalAlignment="Left"
                       Margin="0 0 0 4"/>

              <!-- Cover -->
              <TextBlock Grid.Row="2" Grid.Column="0"
                         Text="{utils:Loc SwallowFoundation.Label.Cover}"
                         VerticalAlignment="Center"
                         Margin="0 0 8 4"/>
              <TextBox Grid.Row="2" Grid.Column="1"
                       Text="{Binding Cover, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                       Style="{StaticResource NumericInputTextBox}"
                       HorizontalAlignment="Left"
                       Margin="0 0 0 4"/>

              <!-- ColumnRebarCountX -->
              <TextBlock Grid.Row="3" Grid.Column="0"
                         Text="{utils:Loc SwallowFoundation.Label.ColumnRebarCountX}"
                         VerticalAlignment="Center"
                         Margin="0 0 8 4"/>
              <TextBox Grid.Row="3" Grid.Column="1"
                       Text="{Binding ColumnRebarCountX, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                       Style="{StaticResource NumericInputTextBox}"
                       HorizontalAlignment="Left"
                       Margin="0 0 0 4"/>

              <!-- ColumnRebarCountY -->
              <TextBlock Grid.Row="4" Grid.Column="0"
                         Text="{utils:Loc SwallowFoundation.Label.ColumnRebarCountY}"
                         VerticalAlignment="Center"
                         Margin="0 0 8 4"/>
              <TextBox Grid.Row="4" Grid.Column="1"
                       Text="{Binding ColumnRebarCountY, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                       Style="{StaticResource NumericInputTextBox}"
                       HorizontalAlignment="Left"
                       Margin="0 0 0 4"/>

              <!-- LapSpliceLength -->
              <TextBlock Grid.Row="5" Grid.Column="0"
                         Text="{utils:Loc SwallowFoundation.Label.LapSpliceLength}"
                         VerticalAlignment="Center"
                         Margin="0 0 8 0"/>
              <TextBox Grid.Row="5" Grid.Column="1"
                       Text="{Binding LapSpliceLength, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                       Style="{StaticResource NumericInputTextBox}"
                       HorizontalAlignment="Left"/>
            </Grid>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

      <!-- Vertical separator -->
      <Rectangle Grid.Column="1"
                Width="1"
                Fill="{StaticResource Container.Static.Border.Default}"
                Margin="0 9"/>

      <!-- ── Right: 2D Preview Canvas ── -->
      <Border Grid.Column="2"
              BorderBrush="{StaticResource Container.Static.Border.Default}"
              BorderThickness="1 0 0 0"
              Margin="9">
        <Canvas x:Name="PreviewCanvas"
                ClipToBounds="True"
                Background="White"/>
      </Border>
    </Grid>
  </DockPanel>
</Window>
