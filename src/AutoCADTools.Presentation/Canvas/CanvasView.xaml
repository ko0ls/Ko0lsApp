<UserControl x:Class="AutoCADTools.Presentation.Canvas.CanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:paz="clr-namespace:Wpf.Controls.PanAndZoom;assembly=Wpf.Controls.PanAndZoom"
             xmlns:converters="clr-namespace:AutoCADTools.Presentation.Converters"
             xmlns:utils="clr-namespace:AutoCADTools.Presentation.Utils"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
  <UserControl.Resources>
    <converters:ConverterMultiParameter x:Key="ConverterMultiParameter" />
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  </UserControl.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
      <paz:ZoomBorder x:Name="MyZoomBorder"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ClipToBounds="True"
                      Focusable="True"
                      Stretch="None"
                      PanButton="Middle"
                      ZoomSpeed="1.2"
                      MouseMove="ZoomBorder_MouseMove"
                      MouseDown="ZoomBorder_MouseDown"
                      MouseUp="ZoomBorder_MouseUp">
        <Canvas x:Name="MyCanvas" Background="Transparent" />
      </paz:ZoomBorder>
    </ScrollViewer>

    <CheckBox Content="{utils:Loc Command.ShowDimension}"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="9"
              Panel.ZIndex="1000"
              IsChecked="{Binding IsShowDim}"
              Visibility="{Binding ShowDimCheckBox, Converter={StaticResource BoolToVisibilityConverter}}" />
  </Grid>
</UserControl>
