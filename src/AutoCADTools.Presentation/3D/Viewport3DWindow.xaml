<Window x:Class="AutoCADTools.Presentation._3D.Viewport3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vp3d="clr-namespace:AutoCADTools.Presentation._3D.Viewport3D"
        xmlns:obj3d="clr-namespace:AutoCADTools.Presentation._3D.ObjectManager3D"
        xmlns:prop3d="clr-namespace:AutoCADTools.Presentation._3D.Properties3D"
        mc:Ignorable="d"
        Title="3D View" Height="600" Width="900"
        MinHeight="400" MinWidth="600"
        Background="#FF1E1E1E"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" MinWidth="150"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="250" MinWidth="180"/>
    </Grid.ColumnDefinitions>

    <!-- Object Manager (left panel) -->
    <Border Grid.Column="0" Background="#FF2D2D30" BorderBrush="#FF3E3E42" BorderThickness="0,0,1,0">
      <obj3d:ObjectManager3DView DataContext="{Binding ObjectManagerViewModel}"/>
    </Border>

    <GridSplitter Grid.Column="1" Width="4" Background="Transparent" HorizontalAlignment="Center"/>

    <!-- Main 3D Viewport -->
    <vp3d:Viewport3DView Grid.Column="2" DataContext="{Binding ViewportViewModel}"/>

    <GridSplitter Grid.Column="3" Width="4" Background="Transparent" HorizontalAlignment="Center"/>

    <!-- Properties panel (right) -->
    <Border Grid.Column="4" Background="#FF2D2D30" BorderBrush="#FF3E3E42" BorderThickness="1,0,0,0">
      <prop3d:Properties3DView DataContext="{Binding PropertiesViewModel}"/>
    </Border>
  </Grid>
</Window>
