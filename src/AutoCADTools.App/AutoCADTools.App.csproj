<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AutoCADTools.App</RootNamespace>
    <AssemblyName>AutoCADTools</AssemblyName>
    <OutputType>Library</OutputType>
    <UseWpf>true</UseWpf>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System"/>
    <Reference Include="System.Core"/>
    <Reference Include="System.Data"/>
    <Reference Include="System.Xml"/>
    <Reference Include="PresentationCore"/>
    <Reference Include="PresentationFramework"/>
    <Reference Include="WindowsBase"/>
    <Reference Include="System.Windows.Forms"/>
    <Reference Include="WindowsFormsIntegration"/>
  </ItemGroup>

  <!-- AutoCAD DLL references -->
  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(ProgramFiles)\Autodesk\AutoCAD $(AutodeskVersion)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(ProgramFiles)\Autodesk\AutoCAD $(AutodeskVersion)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acdbmgdbrep">
      <HintPath>$(ProgramFiles)\Autodesk\AutoCAD $(AutodeskVersion)\acdbmgdbrep.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(ProgramFiles)\Autodesk\AutoCAD $(AutodeskVersion)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcMPolygonMGD">
      <HintPath>$(ProgramFiles)\Autodesk\AutoCAD $(AutodeskVersion)\AcMPolygonMGD.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(ProgramFiles)\Autodesk\AutoCAD $(AutodeskVersion)\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoCADTools.Core\AutoCADTools.Core.csproj"/>
    <ProjectReference Include="..\AutoCADTools.Service\AutoCADTools.Service.csproj"/>
    <ProjectReference Include="..\AutoCADTools.Presentation\AutoCADTools.Presentation.csproj"/>
    <ProjectReference Include="..\AutoCADTools.Storage\AutoCADTools.Storage.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5"/>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.122"/>
    <PackageReference Include="Wpf.Controls.PanAndZoom" Version="2.0.0"/>
  </ItemGroup>

  <ItemGroup>
    <Content Include="PackageContents.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Resources\Icons\swallow_foundation.png" />
  </ItemGroup>

  <!-- Deploy plugin bundle to %ProgramData%\Autodesk\ApplicationPlugins\ -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(ProjectDir)deploy.ps1&quot; &quot;$(OutputPath)&quot;"/>
  </Target>

</Project>
