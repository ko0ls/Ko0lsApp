<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AutoCADTools.App</RootNamespace>
    <AssemblyName>AutoCADTools</AssemblyName>
    <OutputType>Library</OutputType>
    <UseWpf>true</UseWpf>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System"/>
    <Reference Include="System.Core"/>
    <Reference Include="System.Data"/>
    <Reference Include="System.Xml"/>
    <Reference Include="PresentationCore"/>
    <Reference Include="PresentationFramework"/>
    <Reference Include="WindowsBase"/>
    <Reference Include="System.Windows.Forms"/>
    <Reference Include="WindowsFormsIntegration"/>
  </ItemGroup>

  <!-- AutoCAD DLL references -->
  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(ProgramFiles)\Autodesk\AutoCAD $(AutodeskVersion)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(ProgramFiles)\Autodesk\AutoCAD $(AutodeskVersion)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acdbmgdbrep">
      <HintPath>$(ProgramFiles)\Autodesk\AutoCAD $(AutodeskVersion)\acdbmgdbrep.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(ProgramFiles)\Autodesk\AutoCAD $(AutodeskVersion)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcMPolygonMGD">
      <HintPath>$(ProgramFiles)\Autodesk\AutoCAD $(AutodeskVersion)\AcMPolygonMGD.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(ProgramFiles)\Autodesk\AutoCAD $(AutodeskVersion)\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoCADTools.Core\AutoCADTools.Core.csproj"/>
    <ProjectReference Include="..\AutoCADTools.Service\AutoCADTools.Service.csproj"/>
    <ProjectReference Include="..\AutoCADTools.Presentation\AutoCADTools.Presentation.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5"/>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.122"/>
    <PackageReference Include="Wpf.Controls.PanAndZoom" Version="2.0.0"/>
  </ItemGroup>

  <ItemGroup>
    <Content Include="PackageContents.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Deploy plugin bundle to %ProgramData%\Autodesk\ApplicationPlugins\ -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="powershell -ExecutionPolicy Bypass -Command &quot;$out='$(TargetDir)';$bundle=Join-Path $env:ProgramData 'Autodesk\ApplicationPlugins\AutoCADTools.bundle\Contents';$pkg=Join-Path $env:ProgramData 'Autodesk\ApplicationPlugins\AutoCADTools.bundle';if(-Not(Test-Path $bundle)){New-Item -ItemType Directory -Path $bundle -Force|Out-Null};Copy-Item &quot;$out\*.dll&quot; $bundle -Force;Copy-Item &quot;$out\*.pdb&quot; $bundle -Force;Copy-Item &quot;$out\PackageContents.xml&quot; $bundle -Force;Copy-Item '$(ProjectDir)PackageContents.xml' $pkg -Force&quot;"/>
  </Target>

</Project>
